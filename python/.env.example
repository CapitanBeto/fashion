# Fashion Intelligence — Python Engine
# Copiar a .env y completar

# ── Base de datos (mismas credenciales que el Laravel) ────────────────────────
DATABASE_URL=postgresql://fi_user:fi_password_2024@localhost:5432/fashion_intelligence

# ── Seguridad (mismo valor que PYTHON_ENGINE_SECRET en el Laravel .env) ───────
ENGINE_SECRET=secret_largo_aleatorio_cambia_esto

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# ── Scraping ─────────────────────────────────────────────────────────────────
SCRAPE_MODE=FREE
SCRAPE_MAX_COST_USD=0.00
SCRAPE_DEFAULT_DELAY_MS=2000
SCRAPE_MAX_CONCURRENCY=3
SCRAPE_TIMEOUT_SECONDS=30
SCRAPE_RESPECT_ROBOTS=true

# ── Reddit API (gratis — crear app en reddit.com/prefs/apps) ─────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=FashionIntelligence/1.0

# ── Proveedores opcionales (dejar vacío en modo FREE) ─────────────────────────
APIFY_API_TOKEN=
SCRAPERAPI_KEY=
ZYTE_API_KEY=

# ── Bright Data / Instagram ─────────────────────────────────────────────────
BRIGHTDATA_API_TOKEN=

BRIGHTDATA_DATASET_ID_PROFILES=gd_l1vikfch901nx3by4
BRIGHTDATA_DATASET_ID_POSTS=gd_lk5ns7kz21pck8jpis

BRIGHTDATA_MAX_WAIT_SECONDS=300
BRIGHTDATA_POLL_INTERVAL_SECONDS=5
BRIGHTDATA_BATCH_SIZE=50
BRIGHTDATA_POSTS_PER_ACCOUNT=20

