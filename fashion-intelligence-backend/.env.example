# ─────────────────────────────────────────────────────────────────────────────
# FASHION INTELLIGENCE — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Fashion Intelligence"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL recommended (required for pgvector embeddings).
# SQLite works for local testing but pgvector will be disabled.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fashion_intelligence
DB_USERNAME=postgres
DB_PASSWORD=

# SQLite alternative (comment out the above and uncomment below):
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# ── Cache & Queue ─────────────────────────────────────────────────────────────
# Use 'database' for zero-dependency local setup.
# Use 'redis' for production (faster, supports job visibility).
CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis (optional — uncomment if available)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ── Admin Account ────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@fashion-intelligence.local
ADMIN_PASSWORD=changeme123

# ─────────────────────────────────────────────────────────────────────────────
# PYTHON DATA ENGINE
# ─────────────────────────────────────────────────────────────────────────────
PYTHON_ENGINE_URL=http://localhost:8001
PYTHON_ENGINE_SECRET=change-this-to-a-random-secret-string
# Google Trends needs real pauses between requests to avoid being rate
# limited (see SCRAPE_DEFAULT_DELAY_MS below) — a full experiment run can
# take several minutes, so this needs to be generous, not the HTTP default.
PYTHON_ENGINE_TIMEOUT=600

# ─────────────────────────────────────────────────────────────────────────────
# LLM CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Default: Ollama running locally (free, private)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_CONTEXT_WINDOW=8192

# Alternative: OpenAI (costs money, better quality)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# Alternative: Anthropic Claude
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────────────
# SCRAPING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# Mode controls which scraping infrastructure is used:
#   FREE     — only local HTTP + Playwright (no cost, some sites may block)
#   MANAGED  — use paid providers for JS-heavy sites only
#   FULL     — use paid providers for everything
SCRAPE_MODE=FREE

# Budget guard (hard stop — set to 0 for FREE mode)
SCRAPE_MAX_COST_USD=0.00

# Limits
SCRAPE_MAX_REQUESTS=500
SCRAPE_MAX_RECORDS=5000
SCRAPE_MAX_IMAGES=200
SCRAPE_MAX_RUNTIME_MINUTES=60

# Behavior
SCRAPE_DEFAULT_DELAY_MS=2000
SCRAPE_MAX_CONCURRENCY=3
SCRAPE_RETRY_COUNT=3
SCRAPE_TIMEOUT_SECONDS=30
SCRAPE_RESPECT_ROBOTS_TXT=true
SCRAPE_DOWNLOAD_IMAGES=true
SCRAPE_RENDER_JS=false

# ─────────────────────────────────────────────────────────────────────────────
# DATA SOURCES — REDDIT (Official API — free tier)
# Get credentials at: https://www.reddit.com/prefs/apps
# Create a "script" app type
# ─────────────────────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=FashionIntelligence/1.0 (by /u/your_username)

# ─────────────────────────────────────────────────────────────────────────────
# DATA SOURCES — PAID PROVIDERS (all optional, only needed for MANAGED/FULL mode)
# ─────────────────────────────────────────────────────────────────────────────

# Apify — $5 free credit, no card required
# https://apify.com
APIFY_API_TOKEN=
APIFY_DEFAULT_ACTOR_ID=
APIFY_DEFAULT_DATASET_ID=

# ScraperAPI — 5,000 free credits (7 days), no card required
# https://www.scraperapi.com
SCRAPERAPI_KEY=

# Zyte — $5 free credit
# https://www.zyte.com
ZYTE_API_KEY=

# Oxylabs — 2,000 free results trial
# https://oxylabs.io
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Decodo
# https://decodo.com
DECODO_USERNAME=
DECODO_PASSWORD=

# Bright Data
# https://brightdata.com
BRIGHTDATA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# DEMO MODE
# Seeds the UI with static fixture data so you can demo without real scraping
# ─────────────────────────────────────────────────────────────────────────────
DEMO_MODE=false
DEMO_DATA_PATH=experiments/demo/

# ─────────────────────────────────────────────────────────────────────────────
# MAIL (optional — for notifications when experiments complete)
# ─────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@fashion-intelligence.local
MAIL_FROM_NAME="${APP_NAME}"
